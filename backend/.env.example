# Copy this file to .env and fill in real values for your environment.

DATABASE_URL="postgresql://user:password@localhost:5432/cadetes_dev"
JWT_SECRET="replace-with-a-long-random-secret"
VAPID_SUBJECT="mailto:you@example.com"
VAPID_PUBLIC_KEY="replace-with-vapid-public-key"
VAPID_PRIVATE_KEY="replace-with-vapid-private-key"
FRONTEND_ORIGIN="http://localhost:3000"
RESEND_API_KEY="replace-with-resend-api-key"
MAIL_FROM="Gestión de Cadetes <no-reply@yourdomain.com>"

# Optional
PORT=3000

# Only needed in production (docker-compose.yml, cloudflared service):
# Cloudflare Zero Trust dashboard -> Networks -> Tunnels -> your tunnel -> Docker connector token.
TUNNEL_TOKEN="replace-with-cloudflare-tunnel-token"
